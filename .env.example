# Copy this file to ".env.local" for your own computer, and add the same
# values in Vercel (Project → Settings → Environment Variables).

# The public address of the site
NEXT_PUBLIC_SITE_URL=https://www.keleierbreiz.fr

# Sanity (the article editor). Found at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret "Viewer" token, so the site can read the private dataset. Never share it.
SANITY_API_READ_TOKEN=

# Supabase (reader accounts and comments). Found in your Supabase project
# under Project Settings → API Keys (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, for the server only (Stripe webhook and checkout).
# In Vercel, mark it "Sensitive". Never put it in the browser or a chat.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys start with sk_test_ and whsec_). Mark both "Sensitive".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The two prices of "Koumanant Keleier Breiz" (price_…), not secret.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

