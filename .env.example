# Copy this file to ".env.local" for your own computer, and add the same
# values in Vercel (Project → Settings → Environment Variables).

# The public address of the site
NEXT_PUBLIC_SITE_URL=https://www.keleierbreiz.fr

# Sanity (the article editor). Found at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret "Viewer" token, so the site can read the private dataset. Never share it.
SANITY_API_READ_TOKEN=

# Supabase (reader accounts and comments). Found in your Supabase project
# under Project Settings → API Keys (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
